# Copy to .env for local runs, or set these in your shell.
# Never put this key in index.html, app.js or any browser-delivered file.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
# Set to 1 to test the API contract without spending credits. Returns a tone + canned transcript.
VOICE_MOCK=0
# Hard ceiling for the demo. Cached repeats do not count.
VOICE_DAILY_CHAR_CAP=20000
# Comma-separated origins. Use your Pages URL in production.
VOICE_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://abhimanyushukla1214-design.github.io
